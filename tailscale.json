{
  "log": { "level": "info" },
  "dns": {
    "servers": [
      { "type": "https", "tag": "alidns", "server": "dns.alidns.com", "domain_resolver": "hosts" },
      { "type": "hosts", "tag": "hosts", "predefined": { "dns.alidns.com": ["223.5.5.5", "223.6.6.6"] } },
      { "type": "tailscale", "tag": "taildns", "endpoint": "tailnet", "accept_search_domain": true }
    ],
    "rules": [
      { "preferred_by": "taildns", "action": "route", "server": "taildns" }
    ],
    "final": "alidns",
    "cache_capacity": 8192,
    "optimistic": true,
    "reverse_mapping": true
  },
  "endpoints": [
    {
      "type": "tailscale",
      "tag": "tailnet",
      "auth_key": "",
      "accept_routes": true,
      "domain_resolver": "alidns"
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": ["172.19.0.1/30", "fdfe:dcba:9876::1/126"],
      "auto_route": true,
      "strict_route": false
    }
  ],
  "outbounds": [{ "type": "direct", "tag": "direct" }],
  "route": {
    "rules": [
      { "inbound": "tun-in", "action": "sniff" },
      { "protocol": "dns", "action": "hijack-dns" },
      { "preferred_by": "tailnet", "outbound": "tailnet" }
    ],
    "final": "direct",
    "auto_detect_interface": true,
    "default_domain_resolver": "alidns"
  }
}