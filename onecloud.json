{
  "log": { "level": "info" },
  "dns": {
    "servers": [
      { "type": "https", "tag": "doh", "server": "doh.pub", "domain_resolver": "local" },
      { "type": "local", "tag": "local" },
      {
        "type": "tailscale",
        "tag": "taildns",
        "endpoint": "tailnet",
        "accept_search_domain": true
      }
    ],
    "rules": [
      { "preferred_by": "taildns", "action": "route", "server": "taildns" },
      { "domain_suffix": "tailscale.com", "server": "doh" }
    ],
    "final": "local",
    "reverse_mapping": true
  },
  "endpoints": [
    {
      "type": "tailscale",
      "tag": "tailnet",
      "auth_key": "",
      "accept_routes": true,
      "domain_resolver": "doh"
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": ["172.19.0.1/30"],
      "auto_route": true,
      "strict_route": false,
      "stack": "mixed"
    },
    {
      "type": "redirect",
      "tag": "lan-redir",
      "listen": "::",
      "listen_port": 7892
    }
  ],
  "outbounds": [{ "type": "direct", "tag": "direct" }],
  "route": {
    "rules": [
      { "inbound": "tun-in", "action": "sniff" },
      { "protocol": "dns", "action": "hijack-dns" },
      {
        "ip_cidr": ["100.64.0.0/10", "fd7a:115c:a1e0::/48"],
        "outbound": "tailnet"
      }
    ],
    "final": "direct",
    "auto_detect_interface": true,
    "default_domain_resolver": "doh"
  }
}
